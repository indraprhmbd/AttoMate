---

const faqs = [
  {
    q: "Apakah saya perlu punya tim IT untuk menggunakan AttoMate?",
    a: "Tidak sama sekali. Kami yang setup, konfigurasi, dan latih tim Anda. Anda tinggal pakai.",
  },
  {
    q: "Berapa lama proses implementasinya?",
    a: "Untuk kasus penggunaan standar (customer support + follow-up), implementasi bisa selesai dalam 3-7 hari kerja.",
  },
  {
    q: "Apakah AttoMate bisa diintegrasikan dengan WhatsApp?",
    a: "Ya. AttoMate terintegrasi dengan WhatsApp Business API, Instagram, Facebook Messenger, Telegram, dan website live chat.",
  },
  {
    q: "Bagaimana jika AI tidak bisa menjawab pertanyaan pelanggan?",
    a: "AttoMate akan secara otomatis meneruskan percakapan ke tim manusia Anda. Tidak ada pelanggan yang terabaikan.",
  },
  {
    q: "Apakah data bisnis saya aman?",
    a: "Keamanan adalah prioritas utama. Semua data dienkripsi dan tidak pernah digunakan untuk melatih model publik.",
  },
];
---

<section class="px-margin-mobile md:px-margin-desktop py-15 md:py-section-gap max-w-screen-2xl mx-auto" id="faq">
  <div class="mb-16 text-center max-w-3xl mx-auto">
    <h2 class="text-headline-xl font-semibold text-on-background mb-4">Pertanyaan <span class="marker-highlight">Umum</span></h2>
    <p class="text-body-lg text-on-surface-variant">Masih ragu? Mungkin jawabannya sudah ada di sini.</p>
  </div>
  <div class="max-w-3xl mx-auto space-y-4">
    {faqs.map((faq, i) => (
      <details class="group bg-white border-2 border-surface-dim rounded-2xl overflow-hidden transition-all duration-300 open:border-tomato/30 open:shadow-md">
        <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
          <span class="text-body-md font-bold text-on-surface pr-4">{faq.q}</span>
          <span class="material-symbols-outlined text-tomato transition-transform duration-300 group-open:rotate-180 shrink-0">expand_more</span>
        </summary>
        <div class="px-6 pb-6">
          <p class="text-body-md text-on-surface-variant">{faq.a}</p>
        </div>
      </details>
    ))}
  </div>
</section>
