<section class="px-margin-mobile md:px-margin-desktop py-24 bg-on-surface text-white relative overflow-hidden">
  <div class="absolute inset-0 opacity-5 pattern-dots pointer-events-none"></div>
  <div class="max-w-screen-2xl mx-auto relative z-10">
    <div class="mb-20 text-center max-w-3xl mx-auto">
      <h2 class="text-headline-xl font-semibold mb-6">Proses Kami <span class="text-tomato">Tidak Rumit</span></h2>
      <p class="text-body-lg text-surface-dim">Kami membimbing Anda dari proses yang berantakan menjadi operasional yang mulus dan otomatis.</p>
    </div>
    <div class="relative">
      <svg class="hidden md:block absolute top-1/2 left-0 w-full h-24 transform -translate-y-1/2 text-surface-variant/20 z-0" fill="none" preserveAspectRatio="none" stroke="currentColor" viewBox="0 0 1000 100">
        <path class="flow-path" d="M0,50 Q250,-50 500,50 T1000,50" stroke-linecap="round" stroke-width="2"/>
      </svg>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 md:gap-6 relative z-10">
        <div class="flex flex-col items-center text-center relative group">
          <div class="w-16 h-16 rounded-full bg-inverse-surface border-2 border-surface-dim flex items-center justify-center mb-6 group-hover:bg-tomato group-hover:border-tomato transition-colors duration-300 relative">
            <span class="text-xl font-bold">1</span>
            <div class="md:hidden absolute top-16 bottom-[-48px] w-0.5 bg-surface-dim"></div>
          </div>
          <h4 class="text-headline-md font-semibold mb-3">Discovery</h4>
          <p class="text-body-sm text-surface-dim">Kami mendengarkan keluhan operasional Anda dan memetakan proses manual yang paling memakan waktu.</p>
        </div>
        <div class="flex flex-col items-center text-center relative group">
          <div class="w-16 h-16 rounded-full bg-inverse-surface border-2 border-surface-dim flex items-center justify-center mb-6 group-hover:bg-tomato group-hover:border-tomato transition-colors duration-300 relative">
            <span class="text-xl font-bold">2</span>
            <div class="md:hidden absolute top-16 bottom-[-48px] w-0.5 bg-surface-dim"></div>
          </div>
          <h4 class="text-headline-md font-semibold mb-3">Design &amp; Build</h4>
          <p class="text-body-sm text-surface-dim">Merancang sistem otomatisasi kustom (chatbot, integrasi CRM, workflow) yang sesuai dengan DNA brand Anda.</p>
        </div>
        <div class="flex flex-col items-center text-center relative group">
          <div class="w-16 h-16 rounded-full bg-inverse-surface border-2 border-surface-dim flex items-center justify-center mb-6 group-hover:bg-tomato group-hover:border-tomato transition-colors duration-300 relative">
            <span class="text-xl font-bold">3</span>
            <div class="md:hidden absolute top-16 bottom-[-48px] w-0.5 bg-surface-dim"></div>
          </div>
          <h4 class="text-headline-md font-semibold mb-3">Deploy &amp; Train</h4>
          <p class="text-body-sm text-surface-dim">Meluncurkan sistem secara bertahap dan melatih tim Anda agar nyaman bekerja berdampingan dengan AI.</p>
        </div>
        <div class="flex flex-col items-center text-center relative group">
          <div class="w-16 h-16 rounded-full bg-tomato border-2 border-tomato flex items-center justify-center mb-6 shadow-[0_0_20px_rgba(217,103,90,0.5)]">
            <span class="text-xl font-bold text-white material-symbols-outlined">rocket_launch</span>
          </div>
          <h4 class="text-headline-md font-semibold mb-3">Scale</h4>
          <p class="text-body-sm text-surface-dim">Pantau performa, sesuaikan metrik, dan saksikan efisiensi operasional Anda meningkat drastis.</p>
        </div>
      </div>
    </div>
  </div>
</section>
