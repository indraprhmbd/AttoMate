---

---

<section
    class="px-margin-mobile md:px-margin-desktop py-15 md:py-section-gap bg-surface-bright"
>
    <div class="max-w-7xl mx-auto">
        <div
            class="bg-tomato rounded-3xl md:rounded-[40px] p-8 md:p-24 text-center relative overflow-hidden shadow-2xl"
        >
            <svg
                class="absolute top-0 right-0 w-64 h-64 text-white opacity-10 transform translate-x-1/4 -translate-y-1/4 rotate-45"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 100 100"
            >
                <circle cx="50" cy="50" r="40" stroke-width="4"></circle>
            </svg>
            <svg
                class="absolute bottom-0 left-0 w-48 h-48 text-black opacity-10 transform -translate-x-1/4 translate-y-1/4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 100 100"
            >
                <rect x="10" y="10" width="80" height="80" stroke-width="4"
                ></rect>
            </svg>
            <div
                class="relative z-10 max-w-3xl mx-auto flex flex-col items-center"
            >
                <div
                    class="inline-flex items-center gap-2 bg-black/20 text-white px-4 py-2 rounded-full text-label-caps font-semibold backdrop-blur-sm mb-8 border border-white/20"
                >
                    <span
                        class="w-2 h-2 rounded-full bg-green-400 animate-pulse"
                    ></span>
                    SLOT TERBATAS UNTUK KONSULTASI
                </div>
                <h2
                    class="text-display-lg-mobile md:text-headline-xl text-white mb-6 leading-tight"
                >
                    Berhenti Bekerja <span class="italic font-normal"
                        >Di Dalam</span
                    > Bisnis Anda. Mulai Bekerja <span
                        class="underline decoration-4 underline-offset-8"
                        >Untuk</span
                    > Bisnis Anda.
                </h2>
                <p class="text-body-lg text-white/90 mb-12 max-w-2xl">
                    Mari ngobrol santai (tanpa komitmen) tentang proses spesifik
                    di perusahaan Anda yang bikin pusing, dan bagaimana kami
                    bisa mengotomatiskannya.
                </p>
                <a
                    href="/hubungi-kami"
                    class="bg-white text-tomato px-10 py-5 rounded-full text-body-lg font-bold hover:bg-surface-bright shadow-[0_8px_30px_rgb(0,0,0,0.12)] transition-all transform hover:-translate-y-1 duration-300 flex items-center gap-3"
                >
                    <span class="material-symbols-outlined">calendar_today</span
                    >
                    Jadwalkan Ngobrol Bersama
                </a>
                <p
                    class="mt-8 text-sm font-medium text-white/70 flex items-center gap-2"
                >
                    <span class="material-symbols-outlined text-[16px]"
                        >lock</span
                    >
                    Data Anda aman. Tidak ada spam.
                </p>
            </div>
        </div>
    </div>
</section>
