---

---

<section
    class="px-margin-mobile md:px-margin-desktop py-15 md:py-section-gap max-w-screen-2xl mx-auto"
    id="solusi"
>
    <div class="mb-20 md:w-1/2">
        <h2 class="text-headline-xl font-semibold text-on-background mb-4">
            Otomatisasi yang <span class="marker-highlight">Berdampak</span>
        </h2>
        <p class="text-body-lg text-on-surface-variant">
            Kami tidak sekadar menjual bot. Kami mendesain asisten digital yang
            memahami alur bisnis Anda layaknya karyawan terbaik.
        </p>
    </div>
    <div class="space-y-16">
        <div class="relative group">
            <div
                class="absolute -inset-4 bg-pastel-peach rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10"
            >
            </div>
            <div class="flex flex-col md:flex-row gap-12 items-center">
                <div class="md:w-5/12 space-y-6 relative">
                    <div
                        class="absolute -left-6 -top-6 text-[80px] font-bold text-tomato/10 z-0"
                    >
                        01
                    </div>
                    <div class="relative z-10">
                        <h3 class="text-headline-lg font-semibold">
                            Respon Instan, Gaya Manusia
                        </h3>
                        <p class="text-body-md text-on-surface-variant mt-4">
                            Jangan biarkan pelanggan menunggu. AI kami menangani
                            pertanyaan umum 24/7 dengan gaya bahasa yang sesuai
                            dengan brand Anda, lalu meneruskan isu kompleks ke
                            agen manusia.
                        </p>
                        <div class="mt-6 space-y-3">
                            <div class="flex items-center gap-3">
                                <span
                                    class="w-8 h-8 rounded-full bg-tomato text-white flex items-center justify-center text-sm"
                                    ><span
                                        class="material-symbols-outlined text-[18px]"
                                        >forum</span
                                    ></span
                                >
                                <span class="font-medium"
                                    >Balasan Alami &amp; Kontekstual</span
                                >
                            </div>
                            <div class="flex items-center gap-3">
                                <span
                                    class="w-8 h-8 rounded-full bg-tomato text-white flex items-center justify-center text-sm"
                                    ><span
                                        class="material-symbols-outlined text-[18px]"
                                        >support_agent</span
                                    ></span
                                >
                                <span class="font-medium"
                                    >Alihkan ke Tim Anda</span
                                >
                            </div>
                        </div>
                    </div>
                </div>
                <div class="md:w-7/12 w-full relative">
                    <div
                        class="bg-white border-2 border-surface-dim rounded-4xl p-8 shadow-sm flex flex-col md:flex-row items-center gap-6 relative z-10"
                    >
                        <div
                            class="w-full md:w-1/3 bg-surface-container-low p-4 rounded-xl text-center border border-border-base relative"
                        >
                            <span
                                class="material-symbols-outlined text-3xl text-on-surface-variant mb-2"
                                >person</span
                            >
                            <p class="text-sm font-bold">Pelanggan</p>
                            <p class="text-xs text-on-surface-variant mt-1">
                                "Ada warna hitam?"
                            </p>
                        </div>
                        <svg
                            class="w-8 h-8 text-tomato rotate-90 md:rotate-0 shrink-0"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                d="M14 5l7 7m0 0l-7 7m7-7H3"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"></path></svg
                        >
                        <div
                            class="w-full md:w-1/3 bg-pastel-peach p-4 rounded-xl text-center border-2 border-tomato relative transform md:scale-110 shadow-md"
                        >
                            <span
                                class="absolute -top-3 -right-3 w-6 h-6 bg-tomato text-white rounded-full flex items-center justify-center text-xs"
                                ><span
                                    class="material-symbols-outlined text-[14px]"
                                    >smart_toy</span
                                ></span
                            >
                            <p class="text-sm font-bold text-tomato">
                                AttoMate AI
                            </p>
                            <p class="text-xs text-on-surface-variant mt-1">
                                Mengecek database &amp; merespon instan
                            </p>
                        </div>
                        <svg
                            class="w-8 h-8 text-surface-dim rotate-90 md:rotate-0 shrink-0"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                d="M14 5l7 7m0 0l-7 7m7-7H3"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"></path></svg
                        >
                        <div
                            class="w-full md:w-1/3 bg-surface-container-low p-4 rounded-xl text-center border border-border-base relative opacity-50"
                        >
                            <span
                                class="material-symbols-outlined text-3xl text-on-surface-variant mb-2"
                                >support_agent</span
                            >
                            <p class="text-sm font-bold">Tim Support</p>
                            <p class="text-xs text-on-surface-variant mt-1">
                                Fokus pada isu kompleks
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <hr class="border-border-base" />
        <div class="relative group">
            <div
                class="absolute -inset-4 bg-pastel-pink rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10"
            >
            </div>
            <div class="flex flex-col md:flex-row-reverse gap-12 items-center">
                <div class="md:w-5/12 space-y-6 relative">
                    <div
                        class="absolute -right-6 -top-6 text-[80px] font-bold text-secondary/10 z-0"
                    >
                        02
                    </div>
                    <div class="relative z-10">
                        <h3 class="text-headline-lg font-semibold">
                            Sistem Follow-Up Otomatis
                        </h3>
                        <p class="text-body-md text-on-surface-variant mt-4">
                            Jangan biarkan satu pun prospek lepas. Sistem kami
                            mencatat prospek masuk dan mengirimkan follow-up
                            terjadwal secara otomatis di WhatsApp, Email, atau
                            platform lainnya.
                        </p>
                        <div class="mt-6 space-y-3">
                            <div class="flex items-center gap-3">
                                <span
                                    class="w-8 h-8 rounded-full bg-secondary text-white flex items-center justify-center text-sm"
                                    ><span
                                        class="material-symbols-outlined text-[18px]"
                                        >schedule_send</span
                                    ></span
                                >
                                <span class="font-medium"
                                    >Follow-Up Tepat Waktu</span
                                >
                            </div>
                            <div class="flex items-center gap-3">
                                <span
                                    class="w-8 h-8 rounded-full bg-secondary text-white flex items-center justify-center text-sm"
                                    ><span
                                        class="material-symbols-outlined text-[18px]"
                                        >fact_check</span
                                    ></span
                                >
                                <span class="font-medium"
                                    >Pencatatan Lead Otomatis ke CRM</span
                                >
                            </div>
                        </div>
                    </div>
                </div>
                <div class="md:w-7/12 w-full relative">
                    <div
                        class="bg-white border-2 border-surface-dim rounded-4xl p-8 shadow-sm relative z-10 overflow-hidden"
                    >
                        <div
                            class="absolute top-0 right-0 w-32 h-32 bg-pastel-pink rounded-bl-full opacity-50"
                        >
                        </div>
                        <div class="space-y-4 relative">
                            <div class="flex gap-4 relative">
                                <div
                                    class="w-0.5 bg-surface-dim absolute top-8 bottom-[-24px] left-3.75"
                                >
                                </div>
                                <div
                                    class="w-8 h-8 rounded-full bg-surface-container-highest flex items-center justify-center z-10 border-2 border-white"
                                >
                                    <span
                                        class="material-symbols-outlined text-[16px] text-on-surface-variant"
                                        >login</span
                                    >
                                </div>
                                <div
                                    class="flex-1 bg-surface-bright p-3 rounded-xl border border-border-base"
                                >
                                    <p
                                        class="text-xs text-on-surface-variant mb-1"
                                    >
                                        Hari 1 - 10:00 AM
                                    </p>
                                    <p class="text-sm font-bold">
                                        Prospek masuk (Tanya Harga)
                                    </p>
                                </div>
                            </div>
                            <div class="flex gap-4 relative">
                                <div
                                    class="w-0.5 bg-tomato/30 absolute top-8 bottom-[-24px] left-3.75"
                                >
                                </div>
                                <div
                                    class="w-8 h-8 rounded-full bg-tomato flex items-center justify-center z-10 border-2 border-white text-white"
                                >
                                    <span
                                        class="material-symbols-outlined text-[16px]"
                                        >send</span
                                    >
                                </div>
                                <div
                                    class="flex-1 bg-pastel-peach p-3 rounded-xl border border-tomato/20 shadow-sm relative"
                                >
                                    <div
                                        class="absolute right-3 top-3 text-[10px] bg-white px-2 py-0.5 rounded text-tomato font-bold"
                                    >
                                        OTOMATIS
                                    </div>
                                    <p class="text-xs text-tomato mb-1">
                                        Hari 2 - 10:00 AM
                                    </p>
                                    <p class="text-sm font-bold">
                                        Kirim pesan Follow-up 1
                                    </p>
                                    <p
                                        class="text-xs text-on-surface-variant mt-1 italic"
                                    >
                                        "Halo, apakah ada pertanyaan seputar
                                        penawaran kami kemarin?"
                                    </p>
                                </div>
                            </div>
                            <div class="flex gap-4 relative">
                                <div
                                    class="w-8 h-8 rounded-full bg-green-500 flex items-center justify-center z-10 border-2 border-white text-white"
                                >
                                    <span
                                        class="material-symbols-outlined text-[16px]"
                                        >monetization_on</span
                                    >
                                </div>
                                <div
                                    class="flex-1 bg-green-50 p-3 rounded-xl border border-green-200"
                                >
                                    <p class="text-xs text-green-700 mb-1">
                                        Hari 2 - 11:30 AM
                                    </p>
                                    <p class="text-sm font-bold text-green-800">
                                        Prospek membalas &amp; Closing!
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
