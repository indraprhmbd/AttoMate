---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import CTASection from "../components/CTASection.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Tentang AttoMate | AI Automation Agency">
    <Navbar />
    <main>
        <section
            class="px-margin-mobile md:px-margin-desktop pt-28 pb-15 md:pb-section-gap max-w-screen-2xl mx-auto"
        >
            <div class="max-w-3xl mb-12 md:mb-20">
                <h1
                    class="text-display-lg-mobile md:text-headline-xl font-semibold mb-6"
                >
                    Kami Bukan <span class="text-tomato marker-highlight"
                        >Sekadar Chatbot</span
                    >
                </h1>
                <p class="text-body-lg text-on-surface-variant mb-8">
                    AttoMate adalah <strong>AI Automation Agency</strong> yang membantu
                    bisnis di Indonesia mengotomatisasi operasional mereka - dari
                    customer service, follow-up penjualan, hingga manajemen data.
                </p>
                <p class="text-body-lg text-on-surface-variant">
                    Kami percaya teknologi harus bekerja untuk manusia, bukan
                    sebaliknya. Maka kami merancang sistem otomatisasi yang
                    terasa manusiawi, hangat, dan sesuai dengan brand setiap
                    klien.
                </p>
            </div>
            <div
                class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 mb-12 md:mb-20"
            >
                <div
                    class="bg-white rounded-3xl p-8 border-2 border-surface-dim text-center"
                >
                    <p class="text-5xl font-bold text-tomato">5+</p>
                    <p class="text-body-md text-on-surface-variant mt-2">
                        Bisnis percaya
                    </p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 border-2 border-surface-dim text-center"
                >
                    <p class="text-5xl font-bold text-tomato">1K+</p>
                    <p class="text-body-md text-on-surface-variant mt-2">
                        Jam operasional dihemat
                    </p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 border-2 border-surface-dim text-center"
                >
                    <p class="text-5xl font-bold text-tomato">95%</p>
                    <p class="text-body-md text-on-surface-variant mt-2">
                        Kepuasan klien
                    </p>
                </div>
            </div>
            <div
                class="bg-pastel-peach rounded-3xl md:rounded-[40px] p-8 md:p-16"
            >
                <h2 class="text-headline-lg font-semibold mb-6">Visi Kami</h2>
                <p class="text-body-lg text-on-surface-variant max-w-3xl">
                    Menjadi mitra otomatisasi terpercaya bagi UMKM dan bisnis di
                    Indonesia. Membantu mereka bertumbuh tanpa harus tenggelam
                    dalam kerumitan operasional sehari-hari.
                </p>
            </div>
        </section>
        <CTASection />
    </main>
    <Footer />
</BaseLayout>
