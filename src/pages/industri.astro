---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import IndustrySection from "../components/IndustrySection.astro";
import CTASection from "../components/CTASection.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Industri - AttoMate | Solusi Otomatisasi per Sektor">
  <Navbar />
  <main>
    <section class="px-margin-mobile md:px-margin-desktop pt-28 pb-8 md:pb-16 max-w-screen-2xl mx-auto">
      <div class="max-w-3xl">
        <h1 class="text-display-lg-mobile md:text-headline-xl font-semibold mb-6">Solusi untuk <span class="text-tomato marker-highlight">Setiap Industri</span></h1>
        <p class="text-body-lg text-on-surface-variant">Kami memahami setiap industri punya tantangan unik. AttoMate beradaptasi dengan kebutuhan spesifik bisnis Anda.</p>
      </div>
    </section>
    <IndustrySection />
    <CTASection />
  </main>
  <Footer />
</BaseLayout>
